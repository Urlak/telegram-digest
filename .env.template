# Telegram API Credentials
# Get these from https://my.telegram.org/apps (create an application there).
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Optional: phone number for the Telegram user session (interactive auth).
# Example: +15551234567
TG_PHONE_NUMBER=+1234567890

# Bot token (required to run the API/bot service).
# Create a bot with @BotFather: send /newbot, follow the prompts, copy the token.
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Google Gemini API key (not needed when EXPORT_ONLY=True).
GEMINI_API_KEY=your_gemini_api_key_here

# Extraction Options
# A single exact group name or numeric Telegram ID.
# Required only for `python -m src.main --auto`. The bot does not use it.
# Example: TARGET_GROUP=-10012345678
TARGET_GROUP=

# How many messages to fetch per run (per unread batch).
MESSAGE_LIMIT=100

# Hard ceiling for a single fetch, regardless of MESSAGE_LIMIT.
MAX_FETCH_LIMIT=10000

# Lookback window used only for the fallback mode (no unread messages).
HOURS_BACK=24

# Export original messages to Markdown without calling Gemini (True/False).
EXPORT_ONLY=False

# Maximum number of collapsed blocks sent to Gemini.
MAX_LLM_MESSAGES=500

# Maximum total characters sent to Gemini. Truncation is reported honestly.
MAX_LLM_CHARS=60000

# Maximum characters taken from a single collapsed block.
MAX_BLOCK_CHARS=4000

# Timezone for timestamps in prompts, reports and exports.
# Empty means the system timezone of the host/container.
# Example: TIMEZONE=Europe/Moscow
TIMEZONE=

# Network timeouts (seconds) and a small retry budget for 429/503/FloodWait.
GEMINI_TIMEOUT_SECONDS=120
TELEGRAM_TIMEOUT_SECONDS=60
REQUEST_RETRIES=2
MAX_FLOOD_WAIT_SECONDS=300
