# Telegram API Credentials
# Get these from https://my.telegram.org/apps
# Get API_ID and API_HASH from https://my.telegram.org/apps (create an app there)
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Optional: phone number for the Telegram session (used for interactive client auth).
# Example: +15551234567
TG_PHONE_NUMBER=+1234567890

# Bot token (required if you want to use the Telegram bot interface)
# Create a bot with @BotFather on Telegram: send /newbot, follow prompts, then copy the
# API token returned (format: 123456:ABC-DEF...)
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Google Gemini API Key
# Get this from Google AI Studio
# Google Gemini / Generative AI API key. Obtain from Google Cloud / AI Studio or
# your Google Cloud service account/API key configuration. Paste the key here.
GEMINI_API_KEY=your_gemini_api_key_here

# Extraction Options
# Comma-separated list of group names or group IDs to track. Leave blank to list all groups and exit.
# Example: TARGET_GROUP=-10012345678, My Favorite Group
TARGET_GROUP=

# How many messages to fetch per group maximum
MESSAGE_LIMIT=100

# How many hours back to look for messages
HOURS_BACK=24

# Whether to only export messages to Markdown without summarization (True/False)
EXPORT_ONLY=False

# Maximum messages sent to Gemini per group summary
MAX_LLM_MESSAGES=500
